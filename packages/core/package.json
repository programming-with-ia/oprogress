{
  "name": "@oprogress/core",
  "version": "0.0.1",
  "type": "module",
  "description": "NProgress-inspired library with more features",
  "repository": {
    "type": "git",
    "url": "https://github.com/programming-with-ia/oprogress.git"
  },
  "bugs": {
    "url": "https://github.com/programming-with-ia/oprogress/issues"
  },
  "homepage": "https://oprogress.oimmi.com/",
  "author": "oimmi",
  "license": "MIT",
  "keywords": [
    "nprogress",
    "progress",
    "bar",
    "oprogress"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "build": "tsup",
    "dev": "tsup --watch",
    "pub:release": "pnpm publish --no-git-checks --access public",
    "pub:canary": "pnpm publish --no-git-checks --tag canary --access public",
    "pub:beta": "pnpm publish --no-git-checks --tag beta --access public",
    "prepublishOnly": "pnpm test && pnpm lint && pnpm build",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "eslint": "^9.19.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^26.0.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "5.5.4"
  },
  "dependencies": {
    "emittor": "1.0.0-alpha.0",
    "window-change-events": "^0.1.0"
  }
}
